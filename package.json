{
  "name": "cre-activity-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "data:fixture": "node scripts/make-fixture.mjs",
    "data:bundle-demo": "node scripts/make-public-demo.mjs",
    "data:seed": "node scripts/seed.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "data:fetch:chicago": "node scripts/fetch-permits.mjs chicago",
    "data:fetch:nyc": "node scripts/fetch-permits.mjs nyc",
    "data:fetch:permits": "npm run data:fetch:chicago && npm run data:fetch:nyc",
    "data:setup:full": "npm run data:fetch:permits && npm run data:seed && npm run data:verify",
    "data:fetch:zap": "node scripts/refresh-zap.mjs",
    "data:fetch:acris": "node scripts/refresh-acris.mjs",
    "data:fetch:sba": "node scripts/fetch-sba.mjs",
    "test": "vitest run --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "demo": "npm run data:seed && npm run build && npm run start"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "h3-js": "^4.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
